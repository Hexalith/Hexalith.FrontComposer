<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Hexalith.FrontComposer.Contracts" Version="$(FrontComposerPackageVersion)" />
    <PackageReference Include="Hexalith.FrontComposer.Contracts.UI" Version="$(FrontComposerPackageVersion)" />
    <PackageReference Include="Hexalith.FrontComposer.Shell" Version="$(FrontComposerPackageVersion)" />
    <PackageReference Include="Hexalith.FrontComposer.SourceTools" Version="$(FrontComposerPackageVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>
