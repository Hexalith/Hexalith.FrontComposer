@page "/counter"
@page "/counter/{RouteTab}"
@implements IDisposable
@using Counter.Domain
@using System.Collections.Immutable
@using Hexalith.FrontComposer.Shell.Components.Layout

<PageTitle>Counter sample</PageTitle>
@inject IState<Counter.Domain.CounterProjectionState> CounterState
@inject IDispatcher Dispatcher
@inject Hexalith.FrontComposer.Shell.Infrastructure.Tenancy.IFrontComposerTenantContextAccessor TenantContext
@inject IState<Hexalith.FrontComposer.Shell.State.DataGridNavigation.LoadedPageState> LoadedPageState
@inject IState<Hexalith.FrontComposer.Shell.State.DataGridNavigation.DataGridNavigationState> GridNavigationState
@inject IServiceProvider Services

<h1 tabindex="-1">Counter</h1>

<CascadingValue Value="_demoContext">
    <CounterCommandProjectionCatchUp />
    <FcPageTabs ModuleRoute="/counter" DefaultTabId="overview" AriaLabel="Counter pages">
        <FcPageTab Id="overview" Header="Overview">
    <div class="page-container" style="display: flex; flex-direction: column; gap: 24px;">
        @* §4.2 — the three titled command-density specimen sections are grouped in one
           FluentAccordion. ExpandMode=Multi with every item Expanded keeps all three densities
           visible side-by-side (the specimen's purpose + the a11y/visual + command-form e2e gate)
           while still adding the accordion's collapse affordance. HeadingLevel=2 preserves the
           prior <h2> heading order under the page <h1>. The .command-section/.inline-section/
           .fullpage-section classes are kept on the items for the e2e selectors. *@
        <FluentAccordion ExpandMode="AccordionExpandMode.Multi" HeadingLevel="2">
            <FluentAccordionItem Class="create-section" Header="Create with an exact target" Expanded="true">
                <CreateCounterCommandRenderer />
            </FluentAccordionItem>
            <FluentAccordionItem Class="update-section" Header="Update with an exact target" Expanded="true">
                <UpdateCounterCommandRenderer />
            </FluentAccordionItem>
            <FluentAccordionItem Class="command-section" Header="Compact inline (3 fields)" Expanded="true">
                <BatchIncrementCommandRenderer />
            </FluentAccordionItem>
            <FluentAccordionItem Class="inline-section" Header="Inline + popover (1 field)" Expanded="true">
                <IncrementCommandRenderer />
            </FluentAccordionItem>
            <FluentAccordionItem Class="fullpage-section" Header="Full-page command (5 fields)" Expanded="true">
                <p role="note" style="padding: 12px; background: var(--colorNeutralBackground2); border-left: 4px solid var(--colorBrandStroke1);">
                    Navigation state persistence (scroll, filter, sort across FullPage round-trip) lands in Story 4.3.
                    The current demo proves routing + breadcrumb return only.
                </p>
                <a href="/commands/Counter/ConfigureCounterCommand?returnPath=%2Fcounter&amp;projectionTypeFqn=Counter.Domain.CounterProjection">Configure Counter</a>
            </FluentAccordionItem>
        </FluentAccordion>
    </div>
        </FcPageTab>
        <FcPageTab Id="counter-projection" Header="Projection">
    <div class="page-container" style="display: flex; flex-direction: column; gap: 24px;">
        <section class="data-section">
            @if (IsStory13ReadProofEnabled)
            {
                <FluentButton OnClick="@RefreshProjectionForProofAsync"
                              data-testid="fc-story-13-read-proof"
                              data-fc-read-attempts="@_readProofAttempts"
                              data-fc-read-count="@_readProofCount"
                              data-fc-read-row-id="@_readProofRowId">Refresh projection data</FluentButton>
            }
            @if (CounterState.Value.IsLoading || CounterState.Value.Items?.Count > 0)
            {
                <CounterProjectionView />
                @if (IsStory13CoMountedEnabled)
                {
                    <div data-testid="fc-story-13-second-grid"><CounterProjectionView /></div>
                    <FluentButton OnClick="@CaptureCoMountedScrollTop" data-testid="fc-story-13-scroll-probe"
                                  data-fc-scroll-top="@_coMountedScrollTop">Read grid scroll</FluentButton>
                }
            }
            else
            {
                <FluentStack Orientation="Orientation.Vertical"
                             HorizontalAlignment="HorizontalAlignment.Center"
                             VerticalAlignment="VerticalAlignment.Center"
                             Style="padding: 32px; gap: 12px; text-align: center;">
                    <FluentText Size="TextSize.Size400" Weight="TextWeight.Semibold">
                        No counter data yet. Send your first Increment Counter command.
                    </FluentText>
                </FluentStack>
            }
        </section>
    </div>
        </FcPageTab>
    </FcPageTabs>
</CascadingValue>

@code {
    [Parameter]
    public string? RouteTab { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "story13ReadProof")]
    public bool Story13ReadProof { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "story13CoMounted")]
    public bool Story13CoMounted { get; set; }

    private int _readProofCount;
    private int _readProofAttempts;
    private string? _readProofRowId;
    private double _coMountedScrollTop;

    private bool IsStory13ReadProofEnabled => Story13ReadProof
        && Services.GetService(typeof(Microsoft.AspNetCore.Hosting.IWebHostEnvironment))
            is Microsoft.AspNetCore.Hosting.IWebHostEnvironment { EnvironmentName: "Test" };

    private bool IsStory13CoMountedEnabled => Story13CoMounted
        && Services.GetService(typeof(Microsoft.AspNetCore.Hosting.IWebHostEnvironment))
            is Microsoft.AspNetCore.Hosting.IWebHostEnvironment { EnvironmentName: "Test" };

    private void CaptureCoMountedScrollTop()
    {
        const string viewKey = "Counter:Counter.Domain.CounterProjection";
        _coMountedScrollTop = GridNavigationState.Value.ViewStates.TryGetValue(viewKey, out var snapshot)
            ? snapshot.ScrollTop : -1d;
    }

    private async Task RefreshProjectionForProofAsync()
    {
        if (!IsStory13ReadProofEnabled
            || TenantContext.TryGetContext(operationKind: "counter-story-13-read-proof").Context is not { } scope)
        {
            return;
        }

        var scheduler = Services.GetService(typeof(Hexalith.FrontComposer.Shell.State.ProjectionConnection.IProjectionFallbackRefreshScheduler))
            as Hexalith.FrontComposer.Shell.State.ProjectionConnection.IProjectionFallbackRefreshScheduler
            ?? throw new InvalidOperationException("The read proof requires the projection refresh scheduler.");
        var reconciliation = Services.GetService(typeof(Hexalith.FrontComposer.Shell.State.ReconnectionReconciliation.IReconnectionReconciliationCoordinator))
            as Hexalith.FrontComposer.Shell.State.ReconnectionReconciliation.IReconnectionReconciliationCoordinator
            ?? throw new InvalidOperationException("The read proof requires reconciliation.");
        var shellOptions = Services.GetService(typeof(Microsoft.Extensions.Options.IOptions<Hexalith.FrontComposer.Shell.Options.FcShellOptions>))
            as Microsoft.Extensions.Options.IOptions<Hexalith.FrontComposer.Shell.Options.FcShellOptions>
            ?? throw new InvalidOperationException("The read proof requires shell options.");
        int take = shellOptions.Value.VirtualizationServerSideThreshold;
        long scopeGeneration = LoadedPageState.Value.ScopeGeneration;
        // This opt-in Test read uses its own lane and queries the matching primary page
        // before publishing the result to the visible projection.
        using IDisposable lane = scheduler.RegisterLane(new(
            "Counter:Counter.Domain.CounterProjection:story-13-read-proof",
            "Counter.Domain.CounterProjection",
            scope.TenantId,
            0,
            take,
            ImmutableDictionary<string, string>.Empty,
            null,
            false,
            null,
            cancellationToken => ReadProjectionForProofAsync(take, scope, scopeGeneration, cancellationToken)) {
                UserId = scope.UserId, ScopeGeneration = scopeGeneration,
            });
        var result = await reconciliation.ReconcileAsync();
        if (!IsCurrentReadProofScope(scope, scopeGeneration))
        {
            return;
        }

        _readProofAttempts++;
        _readProofCount += result.RefreshedCount;
    }

    private async ValueTask<Hexalith.FrontComposer.Shell.State.ProjectionConnection.ProjectionFallbackLaneRefreshOutcome>
        ReadProjectionForProofAsync(int take, Hexalith.FrontComposer.Shell.Infrastructure.Tenancy.TenantContextSnapshot scope,
            long scopeGeneration, CancellationToken cancellationToken)
    {
        var queries = Services.GetService(typeof(Hexalith.FrontComposer.Contracts.Communication.IQueryService))
            as Hexalith.FrontComposer.Contracts.Communication.IQueryService
            ?? throw new InvalidOperationException("The read proof requires the sample query service.");
        var result = await queries.QueryAsync<CounterProjection>(
            Hexalith.FrontComposer.Contracts.Communication.QueryRequest.Create(
                new Hexalith.FrontComposer.Contracts.Communication.ProjectionQuery(
                    "Counter.Domain.CounterProjection",
                    Skip: 0,
                    Take: take),
                scope.TenantId),
            cancellationToken);
        if (!IsCurrentReadProofScope(scope, scopeGeneration))
        {
            return Hexalith.FrontComposer.Shell.State.ProjectionConnection.ProjectionFallbackLaneRefreshOutcome.Skipped;
        }

        if (result.Items is null || result.IsNotModified)
        {
            throw new InvalidOperationException("The read proof requires a successful page payload.");
        }

        _readProofRowId = result.Items.FirstOrDefault()?.Id;
        Dispatcher.Dispatch(new Hexalith.FrontComposer.Shell.State.DataGridNavigation.LoadPageSucceededAction(
            "Counter:Counter.Domain.CounterProjection",
            0,
            result.Items.Cast<object>().ToArray(),
            result.TotalCount,
            elapsedMs: 0)
        {
            OriginScopeGeneration = scopeGeneration,
            Take = take,
        });
        return Hexalith.FrontComposer.Shell.State.ProjectionConnection.ProjectionFallbackLaneRefreshOutcome.Changed;
    }

    private bool IsCurrentReadProofScope(Hexalith.FrontComposer.Shell.Infrastructure.Tenancy.TenantContextSnapshot scope,
        long scopeGeneration)
        => LoadedPageState.Value.ScopeGeneration == scopeGeneration
            && TenantContext.Revalidate(scope, operationKind: "counter-story-13-read-proof-validation").Succeeded;

    // Story 2-2 Decision D27 — manual CascadingValue to exercise ProjectionContextProvider
    // pre-fill without Epic 4's DataGrid row cascade. Demo-only.
    private readonly Hexalith.FrontComposer.Contracts.Rendering.ProjectionContext _demoContext = new(
        projectionTypeFqn: "Counter.Domain.CounterProjection",
        boundedContext: "Counter",
        aggregateId: "counter-demo-1",
        fields: ImmutableDictionary.CreateRange<string, object?>(
            new Dictionary<string, object?> { ["TenantId"] = "counter-demo" }));

    protected override void OnInitialized()
    {
        CounterState.StateChanged += OnStateChanged;
        if (CounterState.Value.Items?.Count is not > 0
            && TenantContext.TryGetContext(operationKind: "counter-page-seed").Context is { } scope)
        {
            if (!TenantContext.Revalidate(scope, operationKind: "counter-page-request").Succeeded)
            {
                return;
            }

            string correlationId = Guid.NewGuid().ToString("N");
            long projectionScopeGeneration = CounterState.Value.ScopeGeneration;
            Dispatcher.Dispatch(new CounterProjectionLoadRequestedAction(correlationId) { ScopeTenantId = scope.TenantId, ScopeUserId = scope.UserId, OriginScopeGeneration = projectionScopeGeneration });
            if (TenantContext.Revalidate(scope, operationKind: "counter-page-result").Succeeded)
            {
                Dispatcher.Dispatch(new CounterProjectionLoadedAction(
                    correlationId,
                    [
                        new CounterProjection
                        {
                            Id = "counter-1",
                            Count = 0,
                            LastUpdated = DateTimeOffset.UtcNow,
                        },
                    ]) { ScopeTenantId = scope.TenantId, ScopeUserId = scope.UserId, OriginScopeGeneration = projectionScopeGeneration });
            }
        }
    }

    private void OnStateChanged(object? sender, EventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CounterState.StateChanged -= OnStateChanged;
    }
}
