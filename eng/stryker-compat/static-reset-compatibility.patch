+// Private Hexalith compatibility controls for upstream7052; Apache-2.0 source and provenance retained.
+using Microsoft.Extensions.Logging.Abstractions;
+using Moq;
+using Shouldly;
+using Stryker.Abstractions;
+using Stryker.Abstractions.Exceptions;
+using Stryker.Abstractions.Testing;
+using Stryker.TestRunner.MicrosoftTestPlatform.Models;
+using Stryker.TestRunner.Results;
+using Stryker.TestRunner.Tests;
+
+namespace Stryker.TestRunner.MicrosoftTestPlatform.UnitTest;
+
+[TestClass]
+public sealed class MicrosoftTestingPlatformRunnerIsolationCompatibilityTests
+{
+    [TestMethod]
+    [DataRow(true, false)]
+    [DataRow(false, true)]
+    public async Task StaticOrCoverageIsolationResetsBeforeActivation(bool isStatic, bool requiresIsolation)
+    {
+        using var runner = new SessionTrackingRunner();
+        await runner.TestMultipleMutantsAsync(Project(), null, [Mutant(3)], null);
+        runner.Events.Clear();
+
+        await runner.TestMultipleMutantsAsync(Project(), null, [Mutant(7, isStatic, requiresIsolation)], null);
+
+        runner.Events.ShouldBe(["reset:3", "run:7", "reset:-1"]);
+        runner.ReadMutantId().ShouldBe(-1);
+    }
+
+    [TestMethod]
+    [DataRow("passed")]
+    [DataRow("failed")]
+    [DataRow("timeout")]
+    [DataRow("crash")]
+    [DataRow("exception")]
+    public async Task EveryIsolatedOutcomeClearsTheIdAndResetsItsHost(string outcome)
+    {
+        using var runner = new SessionTrackingRunner { Outcome = outcome };
+        var result = await runner.TestMultipleMutantsAsync(Project(), null, [Mutant(7, isStatic: true)], null);
+
+        runner.Events.ShouldBe(["reset:-1", "run:7", "reset:-1"]);
+        runner.ReadMutantId().ShouldBe(-1);
+        result.SessionTimedOut.ShouldBe(outcome == "timeout");
+        result.SessionHadRuntimeIssue.ShouldBe(outcome == "crash");
+        if (outcome == "failed")
+        {
+            result.FailingTests.GetIdentifiers().ShouldBe(["t1"]);
+        }
+        else if (outcome == "timeout")
+        {
+            result.TimedOutTests.GetIdentifiers().ShouldBe(["t1"]);
+        }
+        else if (outcome == "crash")
+        {
+            result.ExecutedTests.GetIdentifiers().ShouldBeEmpty();
+            result.FailingTests.GetIdentifiers().ShouldBeEmpty();
+        }
+        else if (outcome == "exception")
+        {
+            result.ResultMessage.ShouldContain("simulated exception");
+        }
+        else
+        {
+            result.FailingTests.GetIdentifiers().ShouldBeEmpty();
+        }
+    }
+
+    [TestMethod]
+    public async Task StaticFailureCannotPoisonLaterBaselineOrDynamicSessions()
+    {
+        using var runner = new SessionTrackingRunner { Outcome = "static-state" };
+        var baseline = await runner.InitialTestAsync(Project());
+        var isolated = await runner.TestMultipleMutantsAsync(Project(), null, [Mutant(7, isStatic: true)], null);
+        runner.ReadMutantId().ShouldBe(-1);
+        var after = await runner.InitialTestAsync(Project());
+        var dynamic = await runner.TestMultipleMutantsAsync(Project(), null, [Mutant(3)], null);
+
+        baseline.FailingTests.GetIdentifiers().ShouldBeEmpty();
+        isolated.FailingTests.GetIdentifiers().ShouldBe(["t1"]);
+        after.FailingTests.GetIdentifiers().ShouldBeEmpty();
+        dynamic.FailingTests.GetIdentifiers().ShouldBeEmpty();
+        runner.HostBirthIds.ShouldBe([-1, 7, -1]);
+        runner.Events.Count(e => e.StartsWith("reset:", StringComparison.Ordinal)).ShouldBe(2);
+    }
+
+    [TestMethod]
+    public async Task OrdinaryMutantsPreserveHostReuse()
+    {
+        using var runner = new SessionTrackingRunner();
+        await runner.TestMultipleMutantsAsync(Project(), null, [Mutant(3)], null);
+        await runner.TestMultipleMutantsAsync(Project(), null, [Mutant(4)], null);
+
+        runner.Events.ShouldBe(["run:3", "run:4"]);
+        runner.HostBirthIds.ShouldBe([3]);
+    }
+
+    [TestMethod]
+    public async Task EmptyMutantListPreservesTheUnmutatedRun()
+    {
+        using var runner = new SessionTrackingRunner();
+        await runner.TestMultipleMutantsAsync(Project(), null, [], null);
+
+        runner.Events.ShouldBe(["run:-1"]);
+    }
+
+    [TestMethod]
+    [DataRow(false, false)]
+    [DataRow(true, false)]
+    [DataRow(false, true)]
+    public async Task UnexpectedBatchFailsBeforeRunnerStateChanges(bool isStatic, bool requiresIsolation)
+    {
+        using var runner = new SessionTrackingRunner();
+        await runner.TestMultipleMutantsAsync(Project(), null, [Mutant(3)], null);
+        runner.Events.Clear();
+        var project = Project();
+
+        await Should.ThrowAsync<GeneralStrykerException>(() => runner.TestMultipleMutantsAsync(
+            project, null, [Mutant(7, isStatic, requiresIsolation), Mutant(8)], null));
+
+        Mock.Get(project).Verify(x => x.GetTestAssemblies(), Times.Never);
+        runner.Events.ShouldBeEmpty();
+        runner.ReadMutantId().ShouldBe(3);
+    }
+
+    [TestMethod]
+    public async Task FailingInitialResetStillAttemptsCleanupWithoutExecutingTests()
+    {
+        using var runner = new SessionTrackingRunner { ThrowOnReset = 1 };
+
+        await Should.ThrowAsync<InvalidOperationException>(() => runner.TestMultipleMutantsAsync(
+            Project(), null, [Mutant(7, isStatic: true)], null));
+
+        runner.Events.ShouldBe(["reset:-1", "reset:-1"]);
+        runner.ReadMutantId().ShouldBe(-1);
+        runner.HostBirthIds.ShouldBeEmpty();
+    }
+
+    [TestMethod]
+    public async Task FailingFinalResetStillClearsTheActiveMutantAndFailsClosed()
+    {
+        using var runner = new SessionTrackingRunner { ThrowOnReset = 2 };
+
+        await Should.ThrowAsync<InvalidOperationException>(() => runner.TestMultipleMutantsAsync(
+            Project(), null, [Mutant(7, isStatic: true)], null));
+
+        runner.Events.ShouldBe(["reset:-1", "run:7", "reset:-1"]);
+        runner.ReadMutantId().ShouldBe(-1);
+    }
+
+    private static IMutant Mutant(int id, bool isStatic = false, bool requiresIsolation = false)
+    {
+        var mutant = new Mock<IMutant>();
+        mutant.Setup(m => m.Id).Returns(id);
+        mutant.Setup(m => m.IsStaticValue).Returns(isStatic);
+        mutant.Setup(m => m.MustBeTestedInIsolation).Returns(requiresIsolation);
+        return mutant.Object;
+    }
+
+    private static IProjectAndTests Project()
+    {
+        var project = new Mock<IProjectAndTests>();
+        project.Setup(p => p.GetTestAssemblies()).Returns(new List<string> { "/fixture.dll" });
+        return project.Object;
+    }
+
+    private sealed class SessionTrackingRunner() : MicrosoftTestingPlatformRunner(
+        970, [], [], new TestSet(), new object(), NullLogger.Instance)
+    {
+        private int? _staticHostState;
+        private int _resets;
+        public List<string> Events { get; } = [];
+        public List<int> HostBirthIds { get; } = [];
+        public string Outcome { get; init; } = "passed";
+        public int ThrowOnReset { get; init; }
+
+        public int ReadMutantId() => BitConverter.ToInt32(File.ReadAllBytes(MutantFilePath), 0);
+
+        public override async Task ResetServerAsync()
+        {
+            Events.Add($"reset:{ReadMutantId()}");
+            _staticHostState = null;
+            if (++_resets == ThrowOnReset)
+            {
+                throw new InvalidOperationException("simulated reset failure");
+            }
+            await base.ResetServerAsync();
+        }
+
+        internal override Task<(TestRunResult? Result, bool TimedOut, List<TestNode>? DiscoveredTests)> RunAssemblyTestsAsync(
+            string assembly, ITimeoutValueCalculator? timeoutCalc,
+            IReadOnlyList<IMutant>? mutants = null, Func<TestNode, bool>? testUidFilter = null)
+        {
+            var id = ReadMutantId();
+            Events.Add($"run:{id}");
+            if (_staticHostState is null)
+            {
+                HostBirthIds.Add(id);
+                _staticHostState = id == 7 ? 7 : -1;
+            }
+            if (Outcome == "exception")
+            {
+                throw new InvalidOperationException("simulated exception");
+            }
+            if (Outcome == "crash")
+            {
+                return Task.FromResult<(TestRunResult?, bool, List<TestNode>?)>((new TestRunResult(false, "simulated crash"), false, null));
+            }
+            var failed = Outcome == "failed" || (Outcome == "static-state" && _staticHostState == 7);
+            var result = new TestRunResult(
+                Array.Empty<IFrameworkTestDescription>(),
+                Outcome == "timeout" ? TestIdentifierList.NoTest() : new TestIdentifierList("t1"),
+                failed ? new TestIdentifierList("t1") : TestIdentifierList.NoTest(),
+                TestIdentifierList.NoTest(), string.Empty, [], TimeSpan.Zero);
+            return Task.FromResult<(TestRunResult?, bool, List<TestNode>?)>((result, Outcome == "timeout",
+                [new TestNode("t1", "Test", "test", TestNodeStates.Discovered)]));
+        }
+    }
+}
