<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- The owner-approved five-year Verify sponsorship term ends on 2031-09-17.
         Verify 33.1 requires a bounded private-sponsor attestation while the owner's account is
         absent from the package's bundled public-sponsor snapshot. Renew this at most annually. -->
    <FrontComposerVerifySponsorshipApprovedUntil>2031-09-17</FrontComposerVerifySponsorshipApprovedUntil>
    <Verify_GitHubSponsorAccount>jpiquot</Verify_GitHubSponsorAccount>
    <Verify_SponsorshipStart>2026-09-17</Verify_SponsorshipStart>
    <Verify_SponsorshipPrivateUntil>2027-09</Verify_SponsorshipPrivateUntil>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

</Project>
