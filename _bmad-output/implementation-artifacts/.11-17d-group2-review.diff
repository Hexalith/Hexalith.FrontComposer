+        string root = RepositoryRoot();
+        string agents = File.ReadAllText(Path.Combine(root, "AGENTS.md")).ReplaceLineEndings("\n");
+        string claude = File.ReadAllText(Path.Combine(root, "CLAUDE.md")).ReplaceLineEndings("\n");
