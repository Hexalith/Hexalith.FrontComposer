{"type":"before","callId":"call@568","startTime":15811.799,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => {\n    var _owner$aeSpacingClean;\n    const owner = window;\n    (_owner$aeSpacingClean = owner.aeSpacingCleanup) === null || _owner$aeSpacingClean === void 0 || _owner$aeSpacingClean.call(owner);\n    const css = '* { line-height: 1.5 !important; letter-spacing: .12em !important; word-spacing: .16em !important; } p { margin-block-end: 2em !important; }';\n    const roots = new Set();\n    const visit = root => {\n      if (!roots.has(root)) {\n        roots.add(root);\n        observer.observe(root instanceof Document ? root.documentElement : root, {\n          childList: true,\n          subtree: true\n        });\n      }\n      if (!root.querySelector('[data-ae-text-spacing]')) {\n        const style = document.createElement('style');\n        style.dataset.aeTextSpacing = 'true';\n        style.textContent = css;\n        (root instanceof Document ? root.head : root).append(style);\n      }\n      root.querySelectorAll('*').forEach(element => {\n        if (element.shadowRoot) visit(element.shadowRoot);\n      });\n    };\n    const observer = new MutationObserver(() => {\n      for (const root of roots) visit(root);\n    });\n    const original = Element.prototype.attachShadow;\n    const patched = function (init) {\n      const root = original.call(this, init);\n      visit(root);\n      return root;\n    };\n    Element.prototype.attachShadow = patched;\n    owner.aeSpacingCleanup = () => {\n      observer.disconnect();\n      if (Element.prototype.attachShadow === patched) Element.prototype.attachShadow = original;\n      for (const root of roots) root.querySelectorAll('[data-ae-text-spacing]').forEach(style => style.remove());\n      delete owner.aeSpacingCleanup;\n    };\n    visit(document);\n  }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}},"stepId":"pw:api@36"}
