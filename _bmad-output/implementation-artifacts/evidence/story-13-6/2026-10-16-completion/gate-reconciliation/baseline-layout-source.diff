diff --git a/samples/Counter/Counter.Specimens/FrontComposerTypeSpecimen.razor.css b/samples/Counter/Counter.Specimens/FrontComposerTypeSpecimen.razor.css
index 326d4ba3..85d829ab 100644
--- a/samples/Counter/Counter.Specimens/FrontComposerTypeSpecimen.razor.css
+++ b/samples/Counter/Counter.Specimens/FrontComposerTypeSpecimen.razor.css
@@ -164,7 +164,7 @@
 
 /* The fail-closed denial card and form-level warnings keep the readable warning scheme. */
 .fc-specimen ::deep [data-fc-authorization-denied],
-.fc-specimen ::deep fluent-message-bar {
+.fc-specimen ::deep :is([data-testid="fc-destructive-command-specimen"], [data-testid="fc-policy-command-specimen"]) fluent-message-bar {
     background: var(--fc-specimen-warning-background);
     border: 1px solid var(--fc-specimen-warning-border);
     color: var(--fc-specimen-warning-foreground);
@@ -178,6 +178,23 @@
 .fc-specimen__lifecycle { list-style-position: inside; margin-inline-start: 0; padding-inline-start: 0; }
 .fc-specimen :focus-visible { outline: 4px solid #005a9e; outline-offset: 3px; }
 
+/* This specimen's local theme can differ from the shell's Fluent theme. Adapt only
+   the shared grid contour's color to its local surface; geometry belongs to the grid. */
+.fc-specimen ::deep .fc-datagrid-host:focus-visible { outline-color: var(--fc-specimen-foreground); }
+
+@media (max-width: 40rem) {
+    /* Leave room for the specimen's 7px external ring between navigation actions. */
+    .fc-specimen nav li + li,
+    .fc-specimen nav li > ul { margin-block-start: .5rem; }
+
+}
+
+@media (forced-colors: active) {
+    @supports (forced-color-adjust: auto) {
+        .fc-specimen ::deep .fc-datagrid-host:focus-visible { outline-color: CanvasText; }
+    }
+}
+
 @media (prefers-reduced-motion: reduce) {
     .fc-specimen *,
     .fc-specimen *::before,
@@ -198,3 +215,6 @@
         outline-color: Highlight;
     }
 }
+
+/* Specimen actions obey the same pointer-target floor as production surfaces. */
+.fc-specimen a, .fc-specimen summary { display: inline-block; min-block-size: 24px; }
diff --git a/src/Hexalith.FrontComposer.Shell/Components/Layout/FrontComposerShell.razor.css b/src/Hexalith.FrontComposer.Shell/Components/Layout/FrontComposerShell.razor.css
index f2911234..9bb5be8a 100644
--- a/src/Hexalith.FrontComposer.Shell/Components/Layout/FrontComposerShell.razor.css
+++ b/src/Hexalith.FrontComposer.Shell/Components/Layout/FrontComposerShell.razor.css
@@ -7,7 +7,7 @@
 
 .fc-shell-root {
     --layout-header-height: 48px;
-    --fc-color-accent: var(--fc-accent-base-color);
+    --fc-color-accent: var(--colorBrandForeground1);
     --fc-color-neutral: var(--colorNeutralForeground1);
     --fc-color-success: var(--colorStatusSuccessForeground1);
     --fc-color-warning: var(--colorStatusWarningForeground1);
@@ -31,3 +31,25 @@
     max-inline-size: var(--fc-page-max-inline-size, 75rem);
     margin-inline: auto;
 }
+
+/* Content shrinkage belongs to the shell layout, including the 320 CSS-pixel tier. */
+.fc-shell-root { min-inline-size: 0; overflow-wrap: anywhere; }
+#fc-main-content { min-inline-size: 0; inline-size: 100%; }
+.fc-shell-root ::deep .fluent-layout-item { min-inline-size: 0; }
+
+/* Fluent's mobile layout removes the end padding; keep space for the complete focus outline. */
+.fc-shell-root ::deep .fluent-layout[mobile] .fc-shell-content {
+    min-block-size: 0;
+    padding-inline-end: 12px !important;
+}
+
+/* Native focus scrolling must leave room for the shell's complete focus outline. */
+.fc-shell-root ::deep .fc-shell-content { scroll-padding: 8px; }
+.fc-shell-root ::deep :is(a[href], button, input, select, textarea, summary, [tabindex]) { scroll-margin: 8px; }
+
+/* Firefox makes an overflowing content scrollport a native Tab stop. Its own
+   indicator must remain inside the viewport and neighboring shell chrome. */
+.fc-shell-root ::deep .fc-shell-content:focus-visible {
+    outline: var(--strokeWidthThick) solid var(--colorStrokeFocus2);
+    outline-offset: calc(-1 * var(--strokeWidthThick));
+}
diff --git a/src/Hexalith.FrontComposer.Shell/wwwroot/css/fc-projection.css b/src/Hexalith.FrontComposer.Shell/wwwroot/css/fc-projection.css
index 99558f05..5c730d3e 100644
--- a/src/Hexalith.FrontComposer.Shell/wwwroot/css/fc-projection.css
+++ b/src/Hexalith.FrontComposer.Shell/wwwroot/css/fc-projection.css
@@ -161,3 +161,65 @@
         }
     }
 }
+
+/* The labelled grid alone owns horizontal scrolling; the surrounding page can shrink. */
+[data-fc-datagrid] {
+    min-inline-size: 0;
+    max-inline-size: 100%;
+    overflow: auto;
+    padding: 8px;
+    scroll-padding: 8px;
+}
+/* The generated region follows its row count, and diagnostic links sit in tight row
+   flow. Keep their keyboard contours inside their own bounds, clear of adjacent text. */
+.fc-datagrid-host:focus-visible,
+.fc-projection-grid td .fc-field-placeholder a:focus-visible {
+    outline: 2px solid var(--colorStrokeFocus2, #000);
+    outline-offset: -2px;
+}
+
+@media (forced-colors: active) {
+    @supports (forced-color-adjust: auto) {
+        .fc-datagrid-host:focus-visible,
+        .fc-projection-grid td .fc-field-placeholder a:focus-visible { outline-color: CanvasText; }
+    }
+}
+
+.fc-projection-grid { max-inline-size: 100%; min-inline-size: max-content; }
+.fc-projection-grid tr.fluent-data-grid-row > td, .fc-projection-grid th.column-header {
+    overflow: visible;
+    text-overflow: clip;
+}
+.fc-expand-in-row-detail { min-inline-size: 0; overflow-wrap: anywhere; }
+
+[data-fc-datagrid] .fc-projection-grid tbody tr.fluent-data-grid-row {
+    height: var(--fc-grid-row-height);
+}
+.fc-projection-grid td { white-space: nowrap; }
+
+[data-fc-datagrid] :is(a, button, fluent-button, [tabindex]) { scroll-margin: 8px; }
+
+[data-fc-datagrid] { scroll-margin: 8px; }
+/* Tab strips own bounded horizontal scrolling and enough inset for the focus indicator. */
+fluent-tablist { max-inline-size: 100%; overflow-x: auto; padding: 4px; scroll-padding: 8px; box-sizing: border-box; }
+
+/* Keep the complete unsupported-field explanation inline inside the bounded grid. */
+.fc-projection-grid td .fc-field-placeholder { padding: 0; margin: 0; }
+
+/* A focused diagnostic link must fit wholly inside its own bounded scrollport. */
+[data-fc-datagrid] { container-type: inline-size; }
+.fc-projection-grid td .fc-field-placeholder a {
+    inline-size: max-content;
+    max-inline-size: calc(100cqi - 16px);
+    white-space: normal;
+    overflow-wrap: anywhere;
+    margin-inline: 8px;
+}
+
+/* Non-live recovery text is a visible programmatic focus destination. */
+.fc-expanded-row-hidden-banner-text:focus {
+    outline: 2px solid var(--colorStrokeFocus2);
+    outline-offset: 2px;
+}
+
+.fc-expanded-row-hidden-banner { padding: 4px; }
