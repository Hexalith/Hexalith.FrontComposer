+    "change",
+    "create",
+    "delete",
+    "edit",
+    "extend",
+    "generate",
+    "implement",
+    "modify",
+    "move",
+    "remove",
+    "rename",
+    "retarget",
+    "split",
+    "touch",
+    "update",
+    "wire",
+    "write",
