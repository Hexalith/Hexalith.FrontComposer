+# story created is absent from `git ls-files` by construction, so exempting it would
+# make every phantom new-file claim unenforceable.
+CREATION_VERBS = ("add", "create", "generate", "introduce", "write")
+NEGATION_PREFIXES = (
+    "do not",
+    "don't",
+    "does not",
+    "did not",
+    "must not",
+    "should not",
+    "never",
+    "no longer",
+)
