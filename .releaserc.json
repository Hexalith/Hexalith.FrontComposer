{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "python3 eng/release_prepublish.py restore --version ${nextRelease.version}",
        "prepareCmd": "python3 eng/release_prepublish.py verify-prepared --version ${nextRelease.version}",
        "publishCmd": "python3 eng/release_prepublish.py publish --version ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          "nupkgs/*.nupkg",
          "nupkgs/*.snupkg",
          "release-evidence/*.json",
          "release-evidence/*.txt"
        ]
      }
    ]
  ]
}
