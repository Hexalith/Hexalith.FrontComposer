@namespace Hexalith.FrontComposer.Shell.Components.EventStore
@using Hexalith.FrontComposer.Shell.Resources
@using Hexalith.FrontComposer.Shell.State.ProjectionConnection
@using Hexalith.FrontComposer.Shell.State.ReconnectionReconciliation
@using Hexalith.FrontComposer.Shell.Components.Rendering
@using Microsoft.Extensions.Localization
@using Microsoft.FluentUI.AspNetCore.Components

@inject IStringLocalizer<FcShellResources> Localizer

<FcSurfaceStatus Surface="projection-connection" />

@if (_visible) {
    <div class="fc-projection-connection-status-host">
        <FluentMessageBar Intent="@Intent"
                          AllowDismiss="false"
                          role="group"
                          aria-live="off"
                          data-testid="fc-projection-connection-status"
                          Class="@CssClass">
            @Message
        </FluentMessageBar>
    </div>
}

@code {
    private bool _visible => _offline || _snapshot.Status is ProjectionConnectionStatus.Reconnecting or ProjectionConnectionStatus.Disconnected
        || _reconciliation.Status is ReconnectionReconciliationStatus.Reconciling
        || _showReconnected;

    private MessageBarIntent Intent => _offline ? MessageBarIntent.Warning : _snapshot.Status switch {
        ProjectionConnectionStatus.Reconnecting or ProjectionConnectionStatus.Disconnected => MessageBarIntent.Warning,
        _ => MessageBarIntent.Info,
    };

    // P38 — resolve user-visible copy through IStringLocalizer<FcShellResources>. Resource keys
    // were added by Story 5-4; the literals previously hardcoded here meant French-locale users
    // never saw the translated string. Story precedence order is preserved: connection-state
    // (Reconnecting/Disconnected) wins over reconciliation status.
    private string Message => _offline ? Localizer["Am30Offline"] : _snapshot.Status switch {
        ProjectionConnectionStatus.Reconnecting => Localizer["ReconnectStatusText"],
        ProjectionConnectionStatus.Disconnected => Localizer["Am06Fallback"],
        _ when _reconciliation.Status is ReconnectionReconciliationStatus.Reconciling => Localizer["ReconciliationStatusText"],
        _ => Localizer[_reconciliation.DataRead ? "Am07Recovery" : "Am07ConnectionRestored"],
    };

    private string CssClass => _snapshot.Status is ProjectionConnectionStatus.Reconnecting or ProjectionConnectionStatus.Disconnected
        || _reconciliation.Status is ReconnectionReconciliationStatus.Reconciling
            ? "fc-projection-connection-status fc-projection-connection-status-pulse"
            : "fc-projection-connection-status";
}
