@namespace Hexalith.FrontComposer.Shell.Components.Layout
@using Microsoft.FluentUI.AspNetCore.Components

<CascadingValue Value="@this" IsFixed="true">
    @ChildContent
</CascadingValue>

@if (Tabs.Count > 0)
{
    <FluentTabs ActiveTabId="@SelectedTabId"
                ActiveTabIdChanged="@OnActiveTabIdChangedAsync"
                Appearance="@Appearance"
                Disabled="@Disabled"
                Orientation="@Orientation"
                Width="@Width"
                aria-label="@AriaLabel"
                data-testid="@TestId"
                data-fc-module-route="@ModuleRoute">
        @foreach (FcPageTab tab in Tabs)
        {
            <FluentTab @key="tab"
                       Id="@tab.Id"
                       Header="@tab.Header"
                       Disabled="@tab.Disabled"
                       IconStart="@tab.IconStart"
                       DeferredLoading="false"
                       data-fc-module-tab="@(!string.IsNullOrWhiteSpace(ModuleRoute) ? "true" : null)"
                       Tooltip="@tab.Tooltip">
                @if (tab.ShouldRenderContent(SelectedTabId))
                {
                    @tab.ChildContent
                }
            </FluentTab>
        }
    </FluentTabs>
    @if (FallbackMessage is { } message)
    {
        <div @key="(_pendingFallback ?? _announcedFallback)" class="fc-sr-only" role="status" aria-live="polite" aria-atomic="true" data-testid="fc-module-tab-fallback">@message</div>
    }
}
