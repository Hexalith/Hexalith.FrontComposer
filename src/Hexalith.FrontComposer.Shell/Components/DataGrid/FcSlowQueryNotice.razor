@namespace Hexalith.FrontComposer.Shell.Components.DataGrid
@using Microsoft.FluentUI.AspNetCore.Components
@using Hexalith.FrontComposer.Shell.Components.Rendering

@* Story 4-4 T1.2 / D8 / D11 / AC3 — auto-dismissing Info banner for slow-query signals. *@

@if (!SharedStatusOwner)
{
    <FcSurfaceStatus Surface="@("projection:" + ViewKey)" ExclusiveOwner="true" />
}

@if (_visible) {
    <FluentMessageBar Intent="MessageBarIntent.Info"
                      AllowDismiss="false"
                      data-testid="fc-slow-query-notice"
                      aria-live="off">
        @Localizer["Am08SlowQuery"].Value
    </FluentMessageBar>
}
