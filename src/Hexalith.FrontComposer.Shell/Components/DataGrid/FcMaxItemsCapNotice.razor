@namespace Hexalith.FrontComposer.Shell.Components.DataGrid
@using Microsoft.FluentUI.AspNetCore.Components
@using Hexalith.FrontComposer.Shell.Components.Rendering

@* Story 4-4 T1.3 / D11 / AC4 — non-dismissing Info banner shown while the unfiltered cap is active. *@

@if (!SharedStatusOwner)
{
    <FcSurfaceStatus Surface="@("projection:" + ViewKey)" ExclusiveOwner="true" />
}

@if (Visible) {
    <FluentMessageBar Intent="MessageBarIntent.Info"
                      AllowDismiss="false"
                      data-testid="fc-max-items-cap-notice"
                      aria-live="off">
        @_message
    </FluentMessageBar>
}
