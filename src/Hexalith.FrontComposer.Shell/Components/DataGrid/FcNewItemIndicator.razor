@namespace Hexalith.FrontComposer.Shell.Components.DataGrid
@using Hexalith.FrontComposer.Shell.Components.Icons
@using Hexalith.FrontComposer.Shell.Components.Rendering
@using Microsoft.FluentUI.AspNetCore.Components

@if (Entry is null)
{
<div class="fc-new-item-indicator"
     role="status"
     aria-live="polite"
     aria-label="@AriaLabel"
     data-testid="fc-new-item-indicator">
    @ResolvedText
</div>
}
else if (_scopeResolved)
{
    @if (!SharedStatusOwner)
    {
        <FcSurfaceStatus Surface="@("projection:" + Entry.ViewKey)" ExclusiveOwner="true" />
    }
    <div class="fc-new-item-indicator" data-testid="fc-new-item-indicator">
        <FluentIcon Value="@FcFluentIcons.InfoCircle16()" Color="Color.Primary" aria-hidden="true" />
        @ResolvedText
    </div>
}
