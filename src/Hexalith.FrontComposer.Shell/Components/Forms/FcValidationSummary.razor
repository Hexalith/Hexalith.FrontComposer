@namespace Hexalith.FrontComposer.Shell.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.FluentUI.AspNetCore.Components

@if (_visible && _entries.Count > 0) {
    <div class="fc-validation-summary-card">
        <FluentCard>
            @* Story 13.3 VR-01 / AA5-05 — a named group, not a region landmark per form; focus-only, never live. *@
            <section id="@SummaryId"
                     class="fc-validation-summary"
                     role="group"
                     tabindex="-1"
                     aria-labelledby="@TitleId"
                     aria-describedby="@DescriptionId"
                     data-testid="fc-validation-summary"
                     data-fc-validation-kind="@ValidationKindAttribute">
                <FluentText Id="@TitleId"
                            As="TextTag.H2"
                            Size="TextSize.Size400"
                            Weight="TextWeight.Semibold">@Title</FluentText>
                <p id="@DescriptionId">@Description</p>
                <ul>
                    @foreach ((string message, string? inputId, string? label) in _entries) {
                        <li>
                            @if (inputId is not null) {
                                <a href="@FragmentHref(inputId)"
                                   data-fc-validation-target="@inputId"
                                   @onclick="() => FocusFieldAsync(inputId)"
                                   @onclick:preventDefault="@_scriptFocusAvailable">@LinkText(message, label)</a>
                            }
                            else {
                                @message
                            }
                        </li>
                    }
                </ul>
            </section>
        </FluentCard>
    </div>
}
