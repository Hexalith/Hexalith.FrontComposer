@namespace Hexalith.FrontComposer.Shell.Components.Forms
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.FluentUI.AspNetCore.Components

<NavigationLock OnBeforeInternalNavigation="HandleNavigationChangingAsync" />

@if (_showingWarning) {
    <div class="fc-form-abandonment-warning-card">
        <FluentCard>
            <section class="fc-form-abandonment-warning"
                     aria-labelledby="@_warningTitleId"
                     aria-describedby="@_warningDescriptionId"
                     @onkeydown="HandleBarKeyDownAsync"
                     data-testid="fc-form-abandonment-warning">
                <h2 id="@_warningTitleId">@Localizer["FormAbandonmentTitle"]</h2>
                <p id="@_warningDescriptionId">@Localizer["FormAbandonmentDescription"]</p>
                <FluentButton Appearance="ButtonAppearance.Primary"
                              Id="@_stayButtonId"
                              AutoFocus="true"
                              OnClick="OnStayClickedAsync"
                              data-testid="fc-form-abandonment-stay">@Localizer["FormAbandonmentStay"]</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              OnClick="OnLeaveClickedAsync"
                              data-testid="fc-form-abandonment-leave">@Localizer["FormAbandonmentLeave"]</FluentButton>
            </section>
        </FluentCard>
    </div>
}

<div @ref="_guardRoot" data-fc-abandonment-root>
    @ChildContent
</div>
