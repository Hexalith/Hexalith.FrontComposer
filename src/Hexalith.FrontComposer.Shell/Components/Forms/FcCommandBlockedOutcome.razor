@namespace Hexalith.FrontComposer.Shell.Components.Forms
@using Microsoft.FluentUI.AspNetCore.Components
@using Hexalith.FrontComposer.Shell.Components.Rendering

@* Standalone controls own an always-mounted polite node. Generated forms publish to their shared
   node; a visible inline control can own that node for a hidden form. Focus stays on the attempt. *@

@if (Inline) {
    <span class="fc-command-blocked-outcome fc-command-blocked-outcome--inline"
          data-testid="fc-command-blocked-outcome"
          data-fc-blocked="@BlockedAttribute">
        @if (AnnouncementSurface is not null) {
            <span aria-hidden="true" data-testid="fc-command-blocked-visible">@_message</span>
        }
        @if (AnnouncementSurface is null) {
            <span role="status" aria-live="polite" aria-atomic="true"
                  class="fc-command-blocked-status" data-testid="fc-command-blocked-status">@_message</span>
        }
        else if (OwnsSurfaceStatus) {
            <FcSurfaceStatus Surface="@AnnouncementSurface" />
        }
        @if (_blocked && _viewActionAvailable) {
            <FluentButton Type="ButtonType.Button"
                          role="button"
                          Appearance="ButtonAppearance.Outline"
                          OnClick="FocusActiveCommandAsync"
                          data-testid="fc-view-active-command">@ViewActiveCommandLabel</FluentButton>
        }
    </span>
}
else {
    <FluentStack Orientation="Orientation.Horizontal"
                 VerticalAlignment="VerticalAlignment.Center"
                 HorizontalGap="8px"
                 VerticalGap="8px"
                 Wrap="true"
                 Class="fc-command-blocked-outcome"
                 data-testid="fc-command-blocked-outcome"
                 data-fc-blocked="@BlockedAttribute">
        @if (AnnouncementSurface is not null) {
            <span aria-hidden="true" data-testid="fc-command-blocked-visible">@_message</span>
        }
        @if (AnnouncementSurface is null) {
            <div role="status" aria-live="polite" aria-atomic="true"
                 class="fc-command-blocked-status" data-testid="fc-command-blocked-status">@_message</div>
        }
        else if (OwnsSurfaceStatus) {
            <FcSurfaceStatus Surface="@AnnouncementSurface" />
        }
        @if (_blocked && _viewActionAvailable) {
            <FluentButton Type="ButtonType.Button"
                          role="button"
                          Appearance="ButtonAppearance.Outline"
                          OnClick="FocusActiveCommandAsync"
                          data-testid="fc-view-active-command">@ViewActiveCommandLabel</FluentButton>
        }
    </FluentStack>
}
