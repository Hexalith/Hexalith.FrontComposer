@namespace Hexalith.FrontComposer.Shell.Components.Rendering
@implements IDisposable
@inject Hexalith.FrontComposer.Shell.Services.Announcements.ISurfaceAnnouncementCoordinator Announcements

@if (_ownsStatus)
{
<div role="status" aria-live="@(_suppressSpeech ? "off" : "polite")" aria-atomic="true" data-testid="fc-surface-status"
     data-fc-status-message="@(BrowserManaged ? _message : null)"
     data-fc-status-fallback="@(BrowserManaged ? ServerFallback.ToString().ToLowerInvariant() : null)"
     data-fc-status-revision="@(BrowserManaged ? _messageRevision : (long?)null)">
    @if (BrowserManaged)
    {
        @* This static child belongs to the scoped connectivity producer while a circuit is unavailable. *@
        <span data-fc-browser-status>@_browserRenderedMessage</span>
    }
    else if (!string.IsNullOrEmpty(_message))
    {
        <span @key="_messageRevision" data-message-revision="@_messageRevision">@_message</span>
    }
</div>
}

@code {
    [Parameter, EditorRequired]
    public string Surface { get; set; } = string.Empty;

    /// <summary>Shares a single node with other standalone owners of this scoped surface.</summary>
    [Parameter]
    public bool ExclusiveOwner { get; set; }

    /// <summary>Lets the scoped browser connectivity producer render this node without a server round trip.</summary>
    [Parameter]
    public bool BrowserManaged { get; set; }

    /// <summary>Whether the native connectivity watcher now owns the status text.</summary>
    [Parameter]
    public bool BrowserReady { get; set; }

    /// <summary>Whether retained server copy still describes an active connection fallback.</summary>
    [Parameter]
    public bool ServerFallback { get; set; }

    private string _message = string.Empty;
    private string _browserRenderedMessage = string.Empty;
    private long _messageRevision;
    private IDisposable? _subscription;
    private string? _boundSurface;
    private long _bindingGeneration;
    private long _lastAppliedRevision = -1;
    private bool _disposed;
    private bool _ownsStatus = true;
    private bool _suppressSpeech;
    private bool _boundExclusiveOwner;
    private Hexalith.FrontComposer.Shell.Services.Announcements.SurfaceStatusLease? _ownerLease;

    protected override void OnParametersSet()
    {
        if (string.Equals(Surface, _boundSurface, StringComparison.Ordinal) && ExclusiveOwner == _boundExclusiveOwner)
        {
            return;
        }

        long bindingGeneration = ++_bindingGeneration;
        _subscription?.Dispose();
        _ownerLease?.Dispose();
        _ownerLease = null;
        _boundSurface = Surface;
        _boundExclusiveOwner = ExclusiveOwner;
        _message = string.Empty;
        _browserRenderedMessage = string.Empty;
        _suppressSpeech = false;
        _lastAppliedRevision = -1;
        ++_messageRevision;
        string boundSurface = Surface;
        _ownsStatus = true;
        if (ExclusiveOwner)
        {
            _ownerLease = Hexalith.FrontComposer.Shell.Services.Announcements.SurfaceStatusOwnership.For(Announcements)
                .Claim(boundSurface, owns => _ = InvokeAsync(() =>
                {
                    if (!_disposed && _bindingGeneration == bindingGeneration)
                    {
                        _ownsStatus = owns;
                        StateHasChanged();
                    }
                }));
            _ownsStatus = _ownerLease.IsOwner;
        }
        _subscription = Announcements.SubscribeWithReplay(boundSurface, (message, revision) => _ = InvokeAsync(() =>
        {
            if (!_disposed
                && _bindingGeneration == bindingGeneration
                && string.Equals(_boundSurface, boundSurface, StringComparison.Ordinal)
                && revision > _lastAppliedRevision)
            {
                _lastAppliedRevision = revision;
                _message = message;
                if (!BrowserReady)
                {
                    _browserRenderedMessage = message;
                }
                _suppressSpeech = Announcements is Hexalith.FrontComposer.Shell.Services.Announcements.SurfaceAnnouncementCoordinator coordinator
                    && coordinator.IsSilentRevision(boundSurface, revision);
                ++_messageRevision;
                StateHasChanged();
            }
        }));
    }

    public void Dispose()
    {
        _disposed = true;
        _subscription?.Dispose();
        _ownerLease?.Dispose();
    }
}
