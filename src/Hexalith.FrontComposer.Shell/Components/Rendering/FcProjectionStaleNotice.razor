@namespace Hexalith.FrontComposer.Shell.Components.Rendering
@implements IDisposable
@using Hexalith.FrontComposer.Shell.Resources
@using Hexalith.FrontComposer.Shell.Services.Announcements
@using Hexalith.FrontComposer.Shell.State.ProjectionConnection
@inject IProjectionConnectionState Connection
@inject ISurfaceAnnouncementCoordinator Announcements
@inject Microsoft.Extensions.Localization.IStringLocalizer<FcShellResources> Localizer

@if (!SharedStatusOwner) {
    <FcSurfaceStatus Surface="@Surface" ExclusiveOwner="true" />
}

@if (HasCachedRows) {
    <p role="group" aria-live="off" hidden="@(!_visible)"
       data-testid="@(_visible ? "fc-projection-stale-notice" : null)"
       data-fc-browser-stale data-fc-stale-owner="@_browserStaleOwner" data-fc-stale-key="@Surface" data-fc-stale-scope="@ScopeGeneration" data-fc-server-stale="@(_visible ? "true" : "false")"
       data-fc-cached-result="@_confirmedFreshness">@Localizer["Am04Stale"]</p>
}

@code {
    [Parameter, EditorRequired]
    public string Surface { get; set; } = string.Empty;

    /// <summary>Generation of the current scoped projection view.</summary>
    [Parameter]
    public long ScopeGeneration { get; set; }

    /// <summary>Uses the generated projection's existing shared polite status node.</summary>
    [Parameter]
    public bool SharedStatusOwner { get; set; }

    [Parameter]
    public bool HasCachedRows { get; set; }

    [Parameter]
    public bool HasFailedRefresh { get; set; }

    /// <summary>Identifies genuine completed reads of the retained data, independently of connectivity.</summary>
    [Parameter]
    public string? FreshnessIdentity { get; set; }

    /// <summary>Gets or sets the group of the current eligible query failure.</summary>
    [Parameter]
    public string? QueryFailureGroup { get; set; }

    /// <summary>Gets or sets the event identity of the current eligible query failure.</summary>
    [Parameter]
    public string? QueryFailureIdentity { get; set; }

    private string _boundSurface = string.Empty;
    private long _boundScopeGeneration;
    private bool _disposed;
    private IDisposable? _subscription;
    private ProjectionConnectionSnapshot _snapshot = new(ProjectionConnectionStatus.Connected, DateTimeOffset.MinValue, 0, null);
    private bool _visible;
    private string? _activeGroup;
    private string? _activeEpisodeKey;
    private IDisposable? _activeClaim;
    private string? _confirmedFreshness;
    private readonly string _browserStaleOwner = Guid.NewGuid().ToString("N");

    protected override void OnInitialized() {
        _subscription = Connection.Subscribe(snapshot => {
            if (_disposed)
            {
                return;
            }
            _ = InvokeAsync(() =>
            {
                if (_disposed || !ReferenceEquals(Connection.Current, snapshot))
                {
                    return;
                }
                _snapshot = snapshot;
                Reconcile();
                StateHasChanged();
            });
        });
    }

    protected override void OnParametersSet() {
        _snapshot = Connection.Current;
        Reconcile();
    }

    private void Reconcile() {
        if (_disposed)
        {
            return;
        }
        if (!string.Equals(_boundSurface, Surface, StringComparison.Ordinal) || _boundScopeGeneration != ScopeGeneration)
        {
            ReleaseAnnouncement();
            _boundSurface = Surface;
            _boundScopeGeneration = ScopeGeneration;
            _visible = false;
            _confirmedFreshness = null;
        }
        if (FreshnessIdentity is not null)
        {
            _confirmedFreshness = FreshnessIdentity;
        }
        bool visible = HasCachedRows && (_snapshot.IsDisconnected || HasFailedRefresh);
        string reason = _snapshot.BrowserOffline ? "browser-offline" : _snapshot.IsDisconnected ? "transport" : "online";
        _visible = visible;
        string episodeKey = "stale:" + Surface + ":scope:" + ScopeGeneration.ToString(System.Globalization.CultureInfo.InvariantCulture)
            + ":" + _snapshot.Epoch.ToString(System.Globalization.CultureInfo.InvariantCulture)
            + ":" + _snapshot.BrowserOfflineEpisode.ToString(System.Globalization.CultureInfo.InvariantCulture)
            + ":" + reason
            + ":" + (QueryFailureIdentity ?? string.Empty);
        if (_activeGroup is not null && (!_visible || !string.Equals(_activeEpisodeKey, episodeKey, StringComparison.Ordinal))) {
            ReleaseAnnouncement();
        }
        if (_visible) {
            if (_activeGroup is null) {
                _activeClaim = SurfaceAnnouncementGroupOwnership.For(Announcements)
                    .ClaimEpisode(_boundSurface, episodeKey, out string group);
                _activeGroup = group;
                _activeEpisodeKey = episodeKey;
            }
            // The coordinator retains a current stale candidate behind a failure or
            // blocked terminal, then presents it if that terminal owner leaves.
            Announcements.Announce(
                _boundSurface,
                _activeGroup,
                "stale",
                Localizer["Am04Stale"]);
        }
    }

    public void Dispose() {
        _disposed = true;
        _subscription?.Dispose();
        ReleaseAnnouncement();
    }

    private void ReleaseAnnouncement() {
        _activeClaim?.Dispose();
        _activeClaim = null;
        _activeGroup = null;
        _activeEpisodeKey = null;
    }
}
