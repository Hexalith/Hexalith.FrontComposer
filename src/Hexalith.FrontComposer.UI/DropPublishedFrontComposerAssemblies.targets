<Project>
  <!-- Shared by Hexalith.FrontComposer.UI and nested Parties/Tenants project references.
       Tenants.Client (NuGet) still injects published FrontComposer 4.2.0 while this host
       project-references the in-repo graph. Drop only those published compile/runtime
       assets so nested AdminPortal/ConsumerPortal can compile against source. Parties.UI
       project-references Shell but not Contracts; the published Shell package used to
       flow Contracts transitively. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Hexalith.Parties.UI' and '$(HexalithFrontComposerFromSource)' == 'true'">
    <ProjectReference Include="$([MSBuild]::NormalizePath('$(HexalithFrontComposerRoot)', 'src', 'Hexalith.FrontComposer.Contracts', 'Hexalith.FrontComposer.Contracts.csproj'))" />
    <ProjectReference Include="$([MSBuild]::NormalizePath('$(HexalithFrontComposerRoot)', 'src', 'Hexalith.FrontComposer.Contracts.UI', 'Hexalith.FrontComposer.Contracts.UI.csproj'))" />
  </ItemGroup>

  <!-- G-6 sets NUGET_PACKAGES outside ~/.nuget/packages. Match the package id and the
       package-folder name (hexalith.frontcomposer.*), not one global-packages layout.
       Source outputs live under .../hexalith.frontcomposer/ and stay in the graph. -->
  <Target Name="FrontComposerUiDropPublishedFrontComposerAssemblies"
          AfterTargets="ResolvePackageAssets"
          BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_FrontComposerPublishedCompile Include="@(ResolvedCompileFileDefinitions)"
                                      Condition="$([System.String]::Copy('%(ResolvedCompileFileDefinitions.NuGetPackageId)').StartsWith('Hexalith.FrontComposer', StringComparison.OrdinalIgnoreCase))" />
      <_FrontComposerPublishedCompile Include="@(ResolvedCompileFileDefinitions)"
                                      Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '(?i)[/\\]hexalith\.frontcomposer\.[^/\\]+[/\\][0-9]'))" />
      <ResolvedCompileFileDefinitions Remove="@(_FrontComposerPublishedCompile)" />
      <_FrontComposerPublishedRuntime Include="@(RuntimeCopyLocalItems)"
                                      Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.NuGetPackageId)').StartsWith('Hexalith.FrontComposer', StringComparison.OrdinalIgnoreCase))" />
      <_FrontComposerPublishedRuntime Include="@(RuntimeCopyLocalItems)"
                                      Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '(?i)[/\\]hexalith\.frontcomposer\.[^/\\]+[/\\][0-9]'))" />
      <RuntimeCopyLocalItems Remove="@(_FrontComposerPublishedRuntime)" />
    </ItemGroup>
  </Target>

  <Target Name="FrontComposerUiDropPublishedFrontComposerStaticWebAssets"
          AfterTargets="ResolveReferencedProjectsStaticWebAssets"
          BeforeTargets="ResolveBuildCompressedStaticWebAssetsConfiguration;GenerateStaticWebAssetsDevelopmentManifest">
    <ItemGroup>
      <_FrontComposerPublishedStaticAsset Include="@(StaticWebAsset)"
                                          Condition="$([System.String]::Copy('%(StaticWebAsset.NuGetPackageId)').StartsWith('Hexalith.FrontComposer', StringComparison.OrdinalIgnoreCase))" />
      <_FrontComposerPublishedStaticAsset Include="@(StaticWebAsset)"
                                          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '(?i)[/\\]hexalith\.frontcomposer\.[^/\\]+[/\\][0-9]'))" />
      <StaticWebAsset Remove="@(_FrontComposerPublishedStaticAsset)" />
      <_FrontComposerPublishedStaticEndpoint Include="@(StaticWebAssetEndpoint)"
                                             Condition="$([System.String]::Copy('%(StaticWebAssetEndpoint.NuGetPackageId)').StartsWith('Hexalith.FrontComposer', StringComparison.OrdinalIgnoreCase))" />
      <_FrontComposerPublishedStaticEndpoint Include="@(StaticWebAssetEndpoint)"
                                             Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '(?i)[/\\]hexalith\.frontcomposer\.[^/\\]+[/\\][0-9]'))" />
      <StaticWebAssetEndpoint Remove="@(_FrontComposerPublishedStaticEndpoint)" />
    </ItemGroup>
  </Target>
</Project>
