@inject NavigationManager Nav
@inject Microsoft.Extensions.Localization.IStringLocalizer<Hexalith.FrontComposer.Shell.Resources.FcShellResources> Localizer

<CascadingAuthenticationState>
    <LayoutView Layout="typeof(Layout.MainLayout)">
        <Router AppAssembly="typeof(Hexalith.FrontComposer.UI.Components.App).Assembly"
                AdditionalAssemblies="RouteAssemblies">
            <Found Context="routeData">
                <div @key="Hexalith.FrontComposer.Shell.Routing.RouteComponentIdentity.For(routeData)" data-fc-route-content="@Nav.Uri">
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(FcRouteBodyLayout)">
                    <NotAuthorized Context="authState">
                        @if (authState.User.Identity?.IsAuthenticated != true)
                        {
                            <RedirectToChallenge />
                        }
                        else
                        {
                            <div data-fc-route-denied="true"><FcPageLayout Mode="FcPageLayoutMode.Constrained">
                                <FcPageHeader Heading="@Localizer["RouteForbiddenHeading"]"
                                              Description="@ForbiddenMessage" />
                            </FcPageLayout></div>
                        }
                    </NotAuthorized>
                    <Authorizing>
                        <FluentText role="status" aria-live="polite" data-fc-route-authorizing="true">Authorizing...</FluentText>
                    </Authorizing>
                </AuthorizeRouteView>
                </div>
                <FcRouteFocus RouteKey="@Nav.Uri" />
            </Found>
            <NotFound>
                <FcRouteUnavailable @key="Nav.Uri" />
                <FcRouteFocus RouteKey="@Nav.Uri" FocusHeading="false" />
            </NotFound>
        </Router>
    </LayoutView>
</CascadingAuthenticationState>

@code {

    private static readonly System.Reflection.Assembly[] RouteAssemblies =
    [
        typeof(FcModuleLandingPage).Assembly,
        typeof(Hexalith.Tenants.UI.Composition.TenantsFrontComposerDomain).Assembly,
        typeof(Hexalith.Parties.AdminPortal.Components.PartiesAdminPortal).Assembly,
        typeof(Hexalith.Parties.ConsumerPortal.Components.MyProfilePage).Assembly,
    ];

    private string ForbiddenMessage
    {
        get
        {
            string relativePath = Nav.ToBaseRelativePath(Nav.Uri);
            int queryStart = relativePath.IndexOfAny(['?', '#']);
            string path = queryStart >= 0 ? relativePath[..queryStart] : relativePath;
            path = "/" + path.TrimStart('/');
            return path.StartsWith("/admin", StringComparison.OrdinalIgnoreCase)
                ? Localizer["RouteForbiddenAdminDescription"].Value
                : Localizer["RouteForbiddenDescription"].Value;
        }
    }
}
